  "findings": [
    {
      "id": "small-prop-two-outcomes",
      "kind": "atomicity_and_evidence_boundary",
      "scope": [
        "cosplay-gap-c01-small-prop-face-outline"
      ],
      "assessment": "持握位置/朝向是一个可训练的控制变量，但“道具是否传达角色状态”和“是否遮挡面部轮廓/表情”是两个可独立失败的结果轴。当前一篇COSPLAY MODE文字来源直接支持两者；候选的两版对照和分轴验收可执行。",
      "recommendation": "暂作为一个中置信度小道具摆位技能保留，验收分别记录表达和遮挡两项；若未来拆成两个L3，先为每项补充独立直接来源。限定一般小道具，不推导短匕首镜头朝向或持握规范。",
      "image_review": "只核对来源正文和图注；没有打开图片像素。"
    },
    {
      "id": "field-context-and-location",
      "kind": "source_boundary",
      "scope": [
        "field-subject-context",
        "field-scene-story-fit",
        "field-location-time-scout",
        "field-location-feasibility",
        "field-location-reflection",
        "field-intent-result-review"
      ],
      "assessment": "拍前简报/人物背景、故事与地点适配、时段观察、地点可行性等当前技能有直接来源，练习与验收可执行。field-location-reflection在raw中仅有adapted证据，故不应作为正式L3。loop2的field-intent-result-review由DuChemin直接支持“对照意图与照片”，但不等于证明某地点客观讲述了人物故事。",
      "recommendation": "保留已有来源支持的拍前能力。将“这组照片是否传达预定意图”限制为field-intent-result-review；更强的“地点故事线索成立”只留作项目自用复盘问题并标project_designed/待证，不能把改写说成直接支持。field-feedback-to-experiment在raw曾为adapted，canonical现有Derryberry的direct locator明确支持用反馈尝试新技术，单变量试验本身仍标项目设计。"
    },
