# Python does not auto-load this file. Set environment variables in your shell,
# or pass a separately created .env to Docker / your process manager.
LAB_DATA_DIR=.local
LAB_PUBLIC_ORIGIN=http://127.0.0.1:8765
# Direct entry is the default; no passphrase or no-auth marker is required.
LAB_NO_AUTH=1
# Internal session signing secret; empty = generate locally.
# Set LAB_NO_AUTH=0 only to explicitly enable passphrase protection.
LAB_ACCESS_TOKEN=
# Optional, separately billed and only invoked by an explicit analyze command:
OPENAI_API_KEY=
LAB_ANALYSIS_MODEL=
# Optional task-summary sync, not required for the photography library:
NOTION_API_TOKEN=
NOTION_PARENT_PAGE_ID=

# Kept photographs: automatic visual suggestions using the existing Antigravity login.
# Set to 0 to pause automatic classification, including old kept images.
LAB_AUTO_CLASSIFY=1
LAB_CLASSIFICATION_MODEL=gemini-3.8-flash-medium
